# Copiar este archivo como .env y completar con los valores reales.
# NUNCA commitear el archivo .env real al repositorio.

# --- Credenciales (obligatorio) ---
GEMINI_API_KEY=

# --- Credenciales (opcional; sin esto se omite la consulta a Asana) ---
ASANA_ACCESS_TOKEN=

# --- Modelos Gemini a usar (opcional, tienen default) ---
# Conviene fijar una versión concreta: con "-latest" el modelo cambia sin aviso.
# El modelo que respondió queda en meta.modelo de cada informe.
GEMINI_MODEL_JSON=gemini-flash-latest

# --- Base de TecnoMonitor de la que se leen los datos ---
# Producción (Postgres, la misma URL que DATABASE_URL del server):
#   DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/tecnomonitor
# Sin DATABASE_URL se usa el archivo SQLite DB_FILENAME (laboratorio).
DATABASE_URL=

# --- Rutas (opcional, todas relativas a INFORMES_IA_BASE_DIR) ---
INFORMES_IA_BASE_DIR=.
DB_FILENAME=lab_monitor.db
CACHE_FILENAME=docs_cache.json
DOCS_DIRNAME=docs
REPORTES_DIRNAME=reportes
HISTORIAL_DB_FILENAME=reportes_db.sqlite

# --- Fechas y privacidad ---
# Zona horaria de las fechas del período (la base guarda hora local).
ZONA_HORARIA=America/Argentina/Buenos_Aires
# 1 = anonimizar DNI, CUIL, mails y teléfonos de Asana antes de mandarlos a Gemini.
ASANA_ANONIMIZAR=1
